# Required: your OpenAI key (keep it secret; it only lives on the server)
OPENAI_API_KEY=sk-...

# Optional: lock the app behind a shared code people type once
ACCESS_CODE=

# Optional: model choices (check your OpenAI dashboard for what your account can use)
OPENAI_MODEL=gpt-5.5
OPENAI_SEARCH_MODEL=
OPENAI_REASONING=

# Optional: requests allowed per visitor IP per 10 minutes (one decision is about 8 requests)
RATE_LIMIT_PER_10_MIN=80
